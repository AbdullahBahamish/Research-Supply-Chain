          }
        }
      ]
    },
    {
      "name": "03 - Native Odoo ORM API (call_kw)",
      "item": [
        {
          "name": "ORM: Search Read Projects",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"model\": \"research.project\",\n    \"method\": \"search_read\",\n    \"args\": [[]],\n    \"kwargs\": {\n      \"fields\": [\"code\", \"project_name\", \"project_status\", \"start_date\", \"end_date\"]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/web/dataset/call_kw/research.project/search_read",
              "host": ["{{base_url}}"],
              "path": ["web", "dataset", "call_kw", "research.project", "search_read"]
            },
            "description": "Calls native Odoo ORM search_read on research.project model."
          }
        },
        {
          "name": "ORM: Search Read Budgets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"model\": \"project.budget\",\n    \"method\": \"search_read\",\n    \"args\": [[]],\n    \"kwargs\": {\n      \"fields\": [\"project_id\", \"total_amount\", \"spent_amount\", \"remaining_amount\"]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/web/dataset/call_kw/project.budget/search_read",
              "host": ["{{base_url}}"],
              "path": ["web", "dataset", "call_kw", "project.budget", "search_read"]
            },
            "description": "Calls native Odoo ORM search_read on project.budget model."
          }
        }
      ]
    }
  ]
}
