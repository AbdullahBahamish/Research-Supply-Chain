         "unowned paper" loophole from the previous design.
         ==================================================================== -->

    <record id="rule_paper_read" model="ir.rule">
        <field name="name">Paper: Visibility (mirrors project scope, orphans locked)</field>
        <field name="model_id" ref="model_research_paper"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('project_id', '=', False),
             '|', ('project_id.visibility', '=', 'public'),
             '|', ('project_id.lead_researcher_id.user_id', '=', user.id),
                  ('project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
