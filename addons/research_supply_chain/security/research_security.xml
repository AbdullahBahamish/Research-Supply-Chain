<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================================
         SECURITY DOCTRINE
         ==================================================================
         1. GROUPS answer:        "What kind of person is this?"
         2. ACCESS RIGHTS answer: "What can that kind of person touch?"
         3. RECORD RULES answer:  "Can they touch THIS record?"

         Record rules split into two families that are NEVER merged into one
         domain unless explicitly noted:
           (a) VISIBILITY  - who may READ a record (public / project scope)
           (b) OWNERSHIP   - who may WRITE/DELETE a record (owner_id = user,
                              or for research.project: lead_researcher_id)

         A user may always read more than they may write. Nobody but
         Administrator bypasses ownership. Research Manager gets broader
         READ (organisation-wide oversight) and, on a short, explicitly
         called-out list of RELATIONSHIP/FUNCTIONAL models (project team,
         budgets, resources), broader WRITE - because those records are not
         "someone's own work", they are organisational/financial/inventory
         data with a different authorisation story. Everywhere else,
         Manager write is governed by the same ownership rule as everyone
         else.

         perm_read/write/create/unlink are ALWAYS set explicitly on every
         rule below - never left to implicit defaults.
         ==================================================================== -->

    <!-- Module / Privilege Category -->
    <record id="module_category_research_supply_chain" model="ir.module.category">
        <field name="name">Research Supply Chain</field>
        <field name="description">Manage research projects, resources, requirements, experiments, and outputs.</field>
        <field name="sequence">15</field>
    </record>

    <record id="res_groups_privilege_research_supply_chain" model="res.groups.privilege">
        <field name="name">Research Supply Chain</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="module_category_research_supply_chain"/>
    </record>

    <!-- ========================================================================
         GROUPS
         Only Researcher -> Project Lead is a genuine "is-a" inheritance chain.
         Resource Officer, Finance Officer and Research Manager are ORTHOGONAL:
         each implies only the base Research User group, so none of them
         silently acquires research-authoring or leadership capability just
         because it needs its own functional privileges.
         ==================================================================== -->

    <!-- 1. Research User - baseline authenticated participant. Implied by
         every other group, so the ownership rules attached to this group
         apply uniformly to everyone regardless of role. -->
    <record id="group_research_user" model="res.groups">
        <field name="name">Research User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 2. Researcher - performs research work. -->
    <record id="group_researcher" model="res.groups">
        <field name="name">Researcher</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_user'))]"/>
    </record>

    <!-- 3. Project Lead - Principal Investigator / project owner capability.
         Genuinely subsumes Researcher (a Lead can do everything a
         Researcher can), so this is the one legitimate inheritance step. -->
    <record id="group_research_lead" model="res.groups">
        <field name="name">Project Lead</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_researcher'))]"/>
    </record>

    <!-- 4. Resource Officer - organisation-wide resource/inventory management.
         Orthogonal: does NOT imply Researcher/Lead. Managing the equipment
         pool does not imply any authority over other people's research. -->
    <record id="group_research_resource_officer" model="res.groups">
        <field name="name">Resource Officer</field>
        <field name="sequence">25</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_user'))]"/>
    </record>

    <!-- 5. Finance Officer - budget/financial control. Orthogonal for the
         same reason: financial oversight must not grant research authority
         (segregation of duties). -->
    <record id="group_research_finance" model="res.groups">
        <field name="name">Finance Officer</field>
        <field name="sequence">26</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_user'))]"/>
    </record>

    <!-- 6. Research Manager - organisation-wide oversight. Deliberately does
         NOT imply Project Lead: broader READ and a few named functional
         WRITE exceptions, but ordinary ownership rules still gate write
         access to other people's authored records (experiments, outputs,
         papers, requirements). -->
    <record id="group_research_manager" model="res.groups">
        <field name="name">Research Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_user'))]"/>
    </record>

    <!-- 7. Administrator - the sole ownership bypass. -->
    <record id="group_research_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">90</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


    <!-- ========================================================================
         RESEARCH PROJECT
         Ownership anchor: lead_researcher_id.user_id
         ==================================================================== -->

    <record id="rule_project_read" model="ir.rule">
        <field name="name">Research Project: Visibility (public / lead / team member)</field>
        <field name="model_id" ref="model_research_project"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('visibility', '=', 'public'),
             '|', ('lead_researcher_id.user_id', '=', user.id),
                  ('researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_owner_write" model="ir.rule">
        <field name="name">Research Project: Owner Write (Lead only)</field>
        <field name="model_id" ref="model_research_project"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            [('lead_researcher_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_manager_read_all" model="ir.rule">
        <field name="name">Research Project: Manager Organisation-Wide Read</field>
        <field name="model_id" ref="model_research_project"/>
        <field name="groups" eval="[(4, ref('group_research_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_admin_bypass" model="ir.rule">
        <field name="name">Research Project: Administrator Bypass</field>
        <field name="model_id" ref="model_research_project"/>
        <field name="groups" eval="[(4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


    <!-- ========================================================================
