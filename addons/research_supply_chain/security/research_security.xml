<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_research_supply_chain" model="ir.module.category">
        <field name="name">Research Supply Chain</field>
        <field name="description">Manage research projects, resources, requirements, experiments, and outputs.</field>
        <field name="sequence">15</field>
    </record>

    <!-- Privilege Category -->
    <record id="res_groups_privilege_research_supply_chain" model="res.groups.privilege">
        <field name="name">Research Supply Chain</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="module_category_research_supply_chain"/>
    </record>

    <!-- 1. User Group (Viewer) -->
    <record id="group_research_user" model="res.groups">
        <field name="name">User (Viewer)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 2. Researcher Group -->
    <record id="group_researcher" model="res.groups">
        <field name="name">Researcher</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_user'))]"/>
    </record>

    <!-- 3. Project Lead / PI Group -->
    <record id="group_research_lead" model="res.groups">
        <field name="name">Project Lead</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_researcher'))]"/>
    </record>

    <!-- 4. Research Manager Group -->
    <record id="group_research_manager" model="res.groups">
        <field name="name">Research Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_lead'))]"/>
    </record>

    <!-- 5. Administrator Group -->
    <record id="group_research_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_research_supply_chain"/>
        <field name="implied_ids" eval="[(4, ref('group_research_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ==================================================================== -->
    <!-- RECORD RULES                                                         -->
    <!-- ==================================================================== -->

    <!-- Project Visibility Rules -->
    <record id="rule_research_project_user" model="ir.rule">
        <field name="name">Research Project: User/Researcher/Lead Visibility</field>
        <field name="model_id" ref="model_research_project"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('visibility', '=', 'public'), '|', ('lead_researcher_id.user_id', '=', user.id), ('researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_research_project_manager_admin" model="ir.rule">
        <field name="name">Research Project: Manager/Admin Full Access</field>
        <field name="model_id" ref="model_research_project"/>
        <field name="groups" eval="[(4, ref('group_research_manager')), (4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Experiment Rules -->
    <record id="rule_research_experiment_visibility" model="ir.rule">
        <field name="name">Research Experiment: Project Visibility</field>
        <field name="model_id" ref="model_research_experiment"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('project_id.visibility', '=', 'public'), '|', ('project_id.lead_researcher_id.user_id', '=', user.id), ('project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_research_experiment_manager" model="ir.rule">
        <field name="name">Research Experiment: Manager Global Access</field>
        <field name="model_id" ref="model_research_experiment"/>
        <field name="groups" eval="[(4, ref('group_research_manager')), (4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Experiment Resource Allocation Rules -->
    <record id="rule_experiment_resource_project_access" model="ir.rule">
        <field name="name">Experiment Resources: Project Access</field>
        <field name="model_id" ref="model_research_experiment_resource"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('experiment_id.project_id.visibility', '=', 'public'), '|', ('experiment_id.project_id.lead_researcher_id.user_id', '=', user.id), ('experiment_id.project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_experiment_resource_manager" model="ir.rule">
        <field name="name">Experiment Resources: Manager Global Access</field>
        <field name="model_id" ref="model_research_experiment_resource"/>
        <field name="groups" eval="[(4, ref('group_research_manager')), (4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Requirement Rules -->
    <record id="rule_requirement_project_access" model="ir.rule">
        <field name="name">Requirements: Project Access</field>
        <field name="model_id" ref="model_research_requirement"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('project_id.visibility', '=', 'public'), '|', ('project_id.lead_researcher_id.user_id', '=', user.id), ('project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_requirement_manager_global" model="ir.rule">
        <field name="name">Requirements: Manager Global Access</field>
        <field name="model_id" ref="model_research_requirement"/>
        <field name="groups" eval="[(4, ref('group_research_manager')), (4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Research Resource Rules -->
    <record id="rule_research_resource_user" model="ir.rule">
        <field name="name">Research Resource: Project Access</field>
        <field name="model_id" ref="model_research_resource"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('owner_project_id', '=', False), '|', ('owner_project_id.visibility', '=', 'public'), '|', ('owner_project_id.lead_researcher_id.user_id', '=', user.id), ('owner_project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_research_resource_manager_global" model="ir.rule">
        <field name="name">Research Resource: Manager Global Access</field>
        <field name="model_id" ref="model_research_resource"/>
        <field name="groups" eval="[(4, ref('group_research_manager')), (4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Output Rules -->
    <record id="rule_output_project_access" model="ir.rule">
        <field name="name">Outputs: Project Access</field>
        <field name="model_id" ref="model_research_output"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('project_id.visibility', '=', 'public'), '|', ('project_id.lead_researcher_id.user_id', '=', user.id), ('project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_output_manager_global" model="ir.rule">
        <field name="name">Outputs: Manager Global Access</field>
        <field name="model_id" ref="model_research_output"/>
        <field name="groups" eval="[(4, ref('group_research_manager')), (4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Paper Rules -->
    <record id="rule_research_paper_user" model="ir.rule">
        <field name="name">Research Paper: Project Access</field>
        <field name="model_id" ref="model_research_paper"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('project_id', '=', False), '|', ('project_id.visibility', '=', 'public'), '|', ('project_id.lead_researcher_id.user_id', '=', user.id), ('project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_research_paper_manager_global" model="ir.rule">
        <field name="name">Research Paper: Manager Global Access</field>
        <field name="model_id" ref="model_research_paper"/>
        <field name="groups" eval="[(4, ref('group_research_manager')), (4, ref('group_research_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Budget Rules -->
    <record id="rule_budget_project_access" model="ir.rule">
        <field name="name">Project Budgets: Project Access</field>
        <field name="model_id" ref="model_project_budget"/>
        <field name="groups" eval="[(4, ref('group_research_user'))]"/>
        <field name="domain_force">
            ['|', ('project_id.visibility', '=', 'public'), '|', ('project_id.lead_researcher_id.user_id', '=', user.id), ('project_id.researcher_line_ids.researcher_id.user_id', '=', user.id)]
        </field>
    </record>
</odoo>