<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Research Paper Form View -->
    <record id="view_research_paper_form" model="ir.ui.view">
        <field name="name">research.paper.form</field>
        <field name="model">research.paper</field>
        <field name="arch" type="xml">
            <form string="Research Paper">
                <header>
                    <button name="action_submit" type="object" string="Submit Paper" class="oe_highlight" invisible="paper_status != 'draft'" groups="research_supply_chain.group_researcher,research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <button name="action_publish" type="object" string="Publish Paper" class="oe_highlight" invisible="paper_status != 'submitted'" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <button name="action_archive" type="object" string="Archive Paper" invisible="paper_status == 'archived'" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="paper_status != 'archived'" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <field name="paper_status" widget="statusbar" statusbar_visible="draft,submitted,published,archived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="bg-success" invisible="paper_status != 'published'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="paper_name" placeholder="Title of the Scientific Paper..." readonly="paper_status in ('published', 'archived')"/>
                        </h1>
                        <h2>
                            <field name="paper_author" placeholder="Author(s) (e.g. Dr. Jane Doe, Prof. Alan Turing)" readonly="paper_status in ('published', 'archived')"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Project &amp; DOI">
                            <field name="project_id" options="{'no_create': True}" readonly="paper_status in ('published', 'archived')"/>
                            <field name="paper_doi" placeholder="e.g. 10.1038/s41586-023-00000-x" readonly="paper_status in ('published', 'archived')"/>
                        </group>
                        <group string="Publication Metadata">
                            <field name="paper_publication_date" readonly="paper_status in ('published', 'archived')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Abstract &amp; Summary">
                            <field name="paper_abstract" placeholder="Full paper abstract, key findings, and summary..." readonly="paper_status in ('published', 'archived')"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Standard Odoo Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Research Paper List View -->
    <record id="view_research_paper_list" model="ir.ui.view">
        <field name="name">research.paper.list</field>
        <field name="model">research.paper</field>
        <field name="arch" type="xml">
            <list string="Research Papers">
                <field name="paper_name"/>
                <field name="paper_author"/>
                <field name="project_id"/>
                <field name="paper_publication_date"/>
                <field name="paper_doi"/>
                <field name="paper_status" widget="badge" decoration-muted="paper_status == 'draft'" decoration-info="paper_status == 'submitted'" decoration-success="paper_status == 'published'" decoration-danger="paper_status == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- Research Paper Kanban View -->
    <record id="view_research_paper_kanban" model="ir.ui.view">
        <field name="name">research.paper.kanban</field>
        <field name="model">research.paper</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="paper_name"/>
                <field name="paper_author"/>
                <field name="project_id"/>
                <field name="paper_status"/>
                <field name="paper_doi"/>
                <field name="paper_publication_date"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-1">
                            <strong class="o_kanban_record_title text-primary">
                                <field name="paper_name"/>
                            </strong>
                        </div>
                        <div class="text-muted mb-1">
                            <i class="fa fa-user me-1" title="Author"/> <field name="paper_author"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa fa-folder me-1" title="Project"/> <field name="project_id"/>
                        </div>
                        <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                            <div class="oe_kanban_bottom_left">
                                <span class="badge bg-light text-dark border" t-if="record.paper_doi.raw_value">
                                    DOI: <field name="paper_doi"/>
                                </span>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="paper_status" widget="badge" decoration-muted="paper_status == 'draft'" decoration-info="paper_status == 'submitted'" decoration-success="paper_status == 'published'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Research Paper Search View -->
    <record id="view_research_paper_search" model="ir.ui.view">
        <field name="name">research.paper.search</field>
        <field name="model">research.paper</field>
        <field name="arch" type="xml">
            <search string="Search Research Papers">
                <field name="paper_name"/>
                <field name="paper_author"/>
                <field name="paper_doi"/>
                <field name="project_id"/>

                <filter name="draft" string="Draft" domain="[('paper_status', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('paper_status', '=', 'submitted')]"/>
                <filter name="published" string="Published" domain="[('paper_status', '=', 'published')]"/>
                <filter name="archived" string="Archived" domain="[('paper_status', '=', 'archived')]"/>

                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'paper_status'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Research Paper Action -->
    <record id="action_research_paper" model="ir.actions.act_window">
        <field name="name">Research Papers</field>
        <field name="res_model">research.paper</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_research_paper_search"/>
    </record>

</odoo>