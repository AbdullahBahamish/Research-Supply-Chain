<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Researcher Form View -->
    <record id="view_researcher_form" model="ir.ui.view">
        <field name="name">research.researcher.form</field>
        <field name="model">research.researcher</field>
        <field name="arch" type="xml">
            <form string="Researcher Profile">
                <sheet>
                    <widget name="web_ribbon" title="Principal Investigator" bg_color="bg-warning" invisible="not is_principal"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-secondary" invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Researcher Full Name..."/>
                        </h1>
                        <h2>
                            <field name="position" placeholder="Job Title / Position (e.g. Lead Quantum Physicist)"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Account &amp; HR Mapping">
                            <field name="user_id"/>
                            <field name="employee_id" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                            <field name="email"/>
                        </group>
                        <group string="Role &amp; Status">
                            <field name="is_principal"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Expertise &amp; Skills">
                            <field name="expertise" placeholder="Key domains of expertise, programming skills, research focus areas..."/>
                        </page>
                        <page string="Project Allocations">
                            <field name="project_line_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Researcher List View -->
    <record id="view_researcher_list" model="ir.ui.view">
        <field name="name">research.researcher.list</field>
        <field name="model">research.researcher</field>
        <field name="arch" type="xml">
            <list string="Researchers" multi_edit="1">
                <field name="name"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="email"/>
                <field name="position"/>
                <field name="is_principal"/>
            </list>
        </field>
    </record>

    <!-- Researcher Kanban View -->
    <record id="view_researcher_kanban" model="ir.ui.view">
        <field name="name">research.researcher.kanban</field>
        <field name="model">research.researcher</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="email"/>
                <field name="position"/>
                <field name="is_principal"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa fa-user-circle fa-2x text-secondary me-2"/>
                            <strong class="o_kanban_record_title text-primary fs-5">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="text-muted small">
                            <i class="fa fa-briefcase me-1"/> <field name="position"/>
                        </div>
                        <div class="text-muted small">
                            <i class="fa fa-envelope me-1"/> <field name="email"/>
                        </div>
                        <div class="mt-2" t-if="record.is_principal.raw_value">
                            <span class="badge bg-warning text-dark"><i class="fa fa-star me-1"/> Principal Investigator</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Researcher Action -->
    <record id="action_researcher" model="ir.actions.act_window">
        <field name="name">Researchers</field>
        <field name="res_model">research.researcher</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
