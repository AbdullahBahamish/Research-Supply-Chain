<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Research Project List View -->
    <record id="view_research_project_list" model="ir.ui.view">
        <field name="name">research.project.list</field>
        <field name="model">research.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="project_name"/>
                <field name="lead_researcher_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="project_status"/>
            </list>
        </field>
    </record>

    <!-- Research Project Form View -->
    <record id="view_research_project_form" model="ir.ui.view">
        <field name="name">research.project.form</field>
        <field name="model">research.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="project_status" widget="statusbar" statusbar_visible="proposed,approved,in_progress,completed,archived"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="project_name"/>
                            <field name="lead_researcher_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="project_description"/>
                        </page>

                        <page string="Team Members">
                            <field name="researcher_line_ids">
                                <list editable="bottom">
                                    <field name="researcher_id"/>
                                    <field name="role"/>
                                    <field name="allocated_pct"/>
                                    <field name="join_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Budgets">
                            <field name="budget_ids">
                                <list>
                                    <field name="currency_id"/>
                                    <field name="total_amount"/>
                                    <field name="spent_amount"/>
                                    <field name="remaining_amount"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Requirements">
                            <field name="requirement_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="quantity"/>
                                    <field name="priority"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Owned Resources">
                            <field name="resource_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="resource_type"/>
                                    <field name="availability_status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Experiments">
                            <field name="experiment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Research Papers">
                            <field name="paper_ids">
                                <list>
                                    <field name="paper_name"/>
                                    <field name="paper_author"/>
                                    <field name="paper_publication_date"/>
                                    <field name="paper_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Research Project Action -->
    <record id="action_research_project" model="ir.actions.act_window">
        <field name="name">Research Projects</field>
        <field name="res_model">research.project</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>