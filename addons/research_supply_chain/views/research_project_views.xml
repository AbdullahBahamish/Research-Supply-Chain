<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Research Project Form View -->
    <record id="view_research_project_form" model="ir.ui.view">
        <field name="name">research.project.form</field>
        <field name="model">research.project</field>
        <field name="arch" type="xml">
            <form string="Research Project">
                <header>
                    <button name="action_analyze_team_skills" type="object" string="Analyze Team Skills" class="oe_highlight" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <button name="action_get_functional_summary" type="object" string="Functional Summary" class="btn-secondary" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <field name="project_status" widget="statusbar" statusbar_visible="proposed,approved,in_progress,completed,archived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Completed" bg_color="bg-success" invisible="project_status != 'completed'"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-secondary" invisible="active"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-flask" type="action" name="%(action_experiment)d" context="{'search_default_project_id': id}">
                            <div class="o_stat_info">
                                <field name="experiment_count" class="o_stat_value"/>
                                <span class="o_stat_text">Experiments</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-file-text-o" type="action" name="%(action_research_paper)d" context="{'search_default_project_id': id}">
                            <div class="o_stat_info">
                                <field name="paper_count" class="o_stat_value"/>
                                <span class="o_stat_text">Papers</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-pie-chart" type="action" name="%(action_project_budget)d" context="{'search_default_project_id': id}" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin">
                            <div class="o_stat_info">
                                <field name="budget_utilization" widget="statinfo" string="Utilization"/>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                        <h2 class="mt-2">
                            <field name="project_name" placeholder="e.g. Quantum Computing Supply Chain Optimization"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Project Information">
                            <field name="lead_researcher_id" options="{'no_create': True}"/>
                            <field name="visibility" widget="badge" decoration-info="visibility == 'public'" decoration-warning="visibility == 'private'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Schedule &amp; Financials">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="analytic_account_id" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Financial Summary" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin">
                        <group>
                            <field name="total_budget_amount" widget="monetary"/>
                            <field name="total_spent_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="remaining_budget_amount" widget="monetary"/>
                            <field name="budget_utilization" widget="progressbar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="project_description" placeholder="Detailed project scope, goals, and methodologies..."/>
                        </page>
                        <page string="Team Members">
                            <field name="researcher_line_ids">
                                <list editable="bottom">
                                    <field name="researcher_id"/>
                                    <field name="role"/>
                                    <field name="allocated_pct"/>
                                    <field name="join_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Budgets" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin">
                            <field name="budget_ids">
                                <list editable="bottom">
                                    <field name="total_amount" widget="monetary"/>
                                    <field name="spent_amount" widget="monetary"/>
                                    <field name="remaining_amount" widget="monetary"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Requirements">
                            <field name="requirement_ids"/>
                        </page>
                        <page string="Experiments">
                            <field name="experiment_ids"/>
                        </page>
                        <page string="Research Papers">
                            <field name="paper_ids"/>
                        </page>
                        <page string="System Audit Trail" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin">
                            <field name="audit_notes" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Standard Odoo Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Research Project List View -->
    <record id="view_research_project_list" model="ir.ui.view">
        <field name="name">research.project.list</field>
        <field name="model">research.project</field>
        <field name="arch" type="xml">
            <list string="Research Projects" multi_edit="1">
                <field name="code"/>
                <field name="project_name"/>
                <field name="lead_researcher_id"/>
                <field name="visibility" widget="badge" decoration-info="visibility == 'public'" decoration-warning="visibility == 'private'"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_budget_amount" widget="monetary" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                <field name="budget_utilization" widget="progressbar" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                <field name="project_status" widget="badge" decoration-info="project_status in ('proposed', 'approved')" decoration-warning="project_status == 'in_progress'" decoration-success="project_status == 'completed'" decoration-muted="project_status == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- Research Project Kanban View -->
    <record id="view_research_project_kanban" model="ir.ui.view">
        <field name="name">research.project.kanban</field>
        <field name="model">research.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="project_status" class="o_kanban_small_column">
                <field name="code"/>
                <field name="project_name"/>
                <field name="lead_researcher_id"/>
                <field name="project_status"/>
                <field name="visibility"/>
                <field name="total_budget_amount"/>
                <field name="budget_utilization"/>
                <field name="experiment_count"/>
                <field name="paper_count"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-1">
                            <strong class="o_kanban_record_title text-primary">
                                [<field name="code"/>] <field name="project_name"/>
                            </strong>
                        </div>
                        <div class="text-muted mb-2">
                            <i class="fa fa-user me-1" title="Lead Researcher"/> <field name="lead_researcher_id"/>
                            <span class="badge bg-light text-dark border ms-2"><field name="visibility"/></span>
                        </div>
                        <div class="mb-2" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin">
                            <small class="text-muted">Budget Utilization:</small>
                            <field name="budget_utilization" widget="progressbar"/>
                        </div>
                        <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                            <div class="oe_kanban_bottom_left">
                                <span class="badge rounded-pill bg-light text-dark border me-1" title="Experiments">
                                    <i class="fa fa-flask text-info me-1"/> <t t-esc="record.experiment_count.raw_value"/> Exps
                                </span>
                                <span class="badge rounded-pill bg-light text-dark border" title="Papers">
                                    <i class="fa fa-file-text-o text-success me-1"/> <t t-esc="record.paper_count.raw_value"/> Papers
                                </span>
                            </div>
                            <div class="oe_kanban_bottom_right" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin">
                                <strong class="text-nowrap">
                                    <field name="total_budget_amount" widget="monetary"/>
                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Research Project Pivot View (Restricted to Leads, Managers, Owners, Admins) -->
    <record id="view_research_project_pivot" model="ir.ui.view">
        <field name="name">research.project.pivot</field>
        <field name="model">research.project</field>
        <field name="arch" type="xml">
            <pivot string="Projects Analysis">
                <field name="project_status" type="row"/>
                <field name="lead_researcher_id" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Research Project Graph View (Restricted to Leads, Managers, Owners, Admins) -->
    <record id="view_research_project_graph" model="ir.ui.view">
        <field name="name">research.project.graph</field>
        <field name="model">research.project</field>
        <field name="arch" type="xml">
            <graph string="Projects by Status" type="bar">
                <field name="project_status" type="row"/>
            </graph>
        </field>
    </record>

    <!-- Research Project Action -->
    <record id="action_research_project" model="ir.actions.act_window">
        <field name="name">Research Projects</field>
        <field name="res_model">research.project</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Research Project
            </p>
            <p>
                Track budgets, researchers, experiments, resources, and published research papers in one place.
            </p>
        </field>
    </record>

</odoo>