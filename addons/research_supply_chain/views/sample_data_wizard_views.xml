<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_research_sample_data_wizard_form" model="ir.ui.view">
        <field name="name">research.sample.data.wizard.form</field>
        <field name="model">research.sample.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Sample Data">
                <sheet>
                    <group>
                        <group string="Configuration">
                            <field name="num_projects"/>
                            <field name="num_researchers"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Clicking <strong>Generate Fake Data</strong> will populate realistic sample records across Projects, Researchers, Budgets, Requirements, Resources, Experiments, Outputs, and Research Papers.
                    </p>
                </sheet>
                <footer>
                    <button string="Generate Fake Data" type="object" name="action_generate_data" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_research_sample_data_wizard" model="ir.actions.act_window">
        <field name="name">Generate Sample Data</field>
        <field name="res_model">research.sample.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
