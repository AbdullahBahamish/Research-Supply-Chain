<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_research_sample_data_wizard_form" model="ir.ui.view">
        <field name="name">research.sample.data.wizard.form</field>
        <field name="model">research.sample.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Sample Data">
                <group>
                    <field name="num_projects"/>
                    <field name="num_researchers"/>
                </group>
                <footer>
                    <button name="action_generate_data" string="Generate Data" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_research_sample_data_wizard" model="ir.actions.act_window">
        <field name="name">Generate Sample Data</field>
        <field name="res_model">research.sample.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- <field name="groups_id" eval="[(4, ref('research_supply_chain.group_research_admin'))]"/> -->
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_generate_sample_data"
        name="Generate Sample Data"
        parent="menu_tools"
        action="action_research_sample_data_wizard"
        sequence="10"
        groups="research_supply_chain.group_research_admin"
    />

</odoo>