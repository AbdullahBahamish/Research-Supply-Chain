<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Research Resource Form View -->
    <record id="view_research_resource_form" model="ir.ui.view">
        <field name="name">research.resource.form</field>
        <field name="model">research.resource</field>
        <field name="arch" type="xml">
            <form string="Research Resource">
                <sheet>
                    <widget name="web_ribbon" title="Available" bg_color="bg-success" invisible="availability_status != 'available'"/>
                    <widget name="web_ribbon" title="In Use" bg_color="bg-warning" invisible="availability_status != 'in_use'"/>
                    <widget name="web_ribbon" title="Unavailable" bg_color="bg-danger" invisible="availability_status != 'unavailable'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Cryogenic Dilution Refrigerator"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Classification &amp; Availability">
                            <field name="resource_type"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="availability_status" widget="badge" decoration-success="availability_status == 'available'" decoration-warning="availability_status == 'in_use'" decoration-danger="availability_status == 'unavailable'"/>
                        </group>
                        <group string="Ownership">
                            <field name="owner_project_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description &amp; Specifications">
                            <group>
                                <field name="description" placeholder="General resource description..."/>
                                <field name="specification" placeholder="Technical parameters, operating guidelines, hardware specs..."/>
                                <field name="notes" placeholder="Maintenance notes, usage logs..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Research Resource List View -->
    <record id="view_research_resource_list" model="ir.ui.view">
        <field name="name">research.resource.list</field>
        <field name="model">research.resource</field>
        <field name="arch" type="xml">
            <list string="Research Resources" multi_edit="1">
                <field name="name"/>
                <field name="resource_type"/>
                <field name="product_id"/>
                <field name="owner_project_id"/>
                <field name="availability_status" widget="badge" decoration-success="availability_status == 'available'" decoration-warning="availability_status == 'in_use'" decoration-danger="availability_status == 'unavailable'"/>
            </list>
        </field>
    </record>

    <!-- Research Resource Kanban View -->
    <record id="view_research_resource_kanban" model="ir.ui.view">
        <field name="name">research.resource.kanban</field>
        <field name="model">research.resource</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="resource_type"/>
                <field name="availability_status"/>
                <field name="owner_project_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-1">
                            <strong class="o_kanban_record_title text-primary">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="text-muted mb-2">
                            <i class="fa fa-folder me-1"/> <field name="owner_project_id"/>
                        </div>
                        <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                            <div class="oe_kanban_bottom_left">
                                <span class="badge bg-secondary">
                                    <i class="fa fa-cube me-1"/> <field name="resource_type"/>
                                </span>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="availability_status" widget="label_selection" options="{'classes': {'available': 'success', 'in_use': 'warning', 'unavailable': 'danger'}}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Research Resource Action -->
    <record id="action_research_resource" model="ir.actions.act_window">
        <field name="name">Research Resources</field>
        <field name="res_model">research.resource</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
