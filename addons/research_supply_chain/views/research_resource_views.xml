<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Research Resource List View -->
    <record id="view_research_resource_list" model="ir.ui.view">
        <field name="name">research.resource.list</field>
        <field name="model">research.resource</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="resource_type"/>
                <field name="availability_status"/>
                <field name="owner_project_id"/>
            </list>
        </field>
    </record>

    <!-- Research Resource Form View -->
    <record id="view_research_resource_form" model="ir.ui.view">
        <field name="name">research.resource.form</field>
        <field name="model">research.resource</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="availability_status" widget="statusbar" statusbar_visible="available,in_use,unavailable"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="resource_type"/>
                        </group>
                        <group>
                            <field name="owner_project_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Specification">
                            <field name="specification"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Research Resource Action -->
    <record id="action_research_resource" model="ir.actions.act_window">
        <field name="name">Research Resources</field>
        <field name="res_model">research.resource</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
