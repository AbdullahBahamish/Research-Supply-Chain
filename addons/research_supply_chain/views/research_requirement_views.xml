<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Research Requirement List View -->
    <record id="view_research_requirement_list" model="ir.ui.view">
        <field name="name">research.requirement.list</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="category"/>
                <field name="quantity"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="needed_by"/>
            </list>
        </field>
    </record>

    <!-- Research Requirement Form View -->
    <record id="view_research_requirement_form" model="ir.ui.view">
        <field name="name">research.requirement.form</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="requested,approved,fulfilled,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="category"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="requested_date"/>
                            <field name="needed_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Research Requirement Action -->
    <record id="action_research_requirement" model="ir.actions.act_window">
        <field name="name">Research Requirements</field>
        <field name="res_model">research.requirement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
