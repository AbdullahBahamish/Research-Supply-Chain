<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Research Requirement Form View -->
    <record id="view_research_requirement_form" model="ir.ui.view">
        <field name="name">research.requirement.form</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <form string="Research Requirement">
                <header>
                    <button name="action_approve" type="object" string="Approve Requirement" class="oe_highlight" invisible="status != 'requested'" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <button name="action_fulfill" type="object" string="Mark as Fulfilled" class="oe_highlight" invisible="status != 'approved'" groups="research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status in ('fulfilled', 'cancelled')" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <button name="action_reset_draft" type="object" string="Reset to Requested" invisible="status != 'cancelled'" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <field name="status" widget="statusbar" statusbar_visible="requested,approved,fulfilled,cancelled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Fulfilled" bg_color="bg-success" invisible="status != 'fulfilled'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-secondary" invisible="status != 'cancelled'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. High-Performance GPU Cluster Allocation" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Classification &amp; Quantity">
                            <field name="category" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                            <field name="product_id" options="{'no_create': True}" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                            <field name="quantity" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                            <field name="priority" widget="badge" decoration-danger="priority == 'high'" decoration-warning="priority == 'medium'" decoration-info="priority == 'low'" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                        </group>
                        <group string="Project &amp; Schedule">
                            <field name="project_id" options="{'no_create': True}" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                            <field name="parent_id" domain="[('project_id', '=', project_id)]" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                            <field name="requested_date" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                            <field name="needed_by" readonly="status in ('approved', 'fulfilled', 'cancelled')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Technical specifications, requirements details, and fulfillment guidelines..." readonly="status in ('fulfilled', 'cancelled')"/>
                        </page>
                        <page string="Child Requirements">
                            <field name="child_ids" readonly="status in ('fulfilled', 'cancelled')">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="quantity"/>
                                    <field name="priority" widget="badge"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Research Requirement List View -->
    <record id="view_research_requirement_list" model="ir.ui.view">
        <field name="name">research.requirement.list</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <list string="Research Requirements">
                <field name="name"/>
                <field name="category"/>
                <field name="product_id"/>
                <field name="project_id"/>
                <field name="quantity"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'high'" decoration-warning="priority == 'medium'" decoration-info="priority == 'low'"/>
                <field name="status" widget="badge" decoration-info="status == 'requested'" decoration-warning="status == 'approved'" decoration-success="status == 'fulfilled'" decoration-muted="status == 'cancelled'"/>
                <field name="needed_by"/>
            </list>
        </field>
    </record>

    <!-- Research Requirement Kanban View -->
    <record id="view_research_requirement_kanban" model="ir.ui.view">
        <field name="name">research.requirement.kanban</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="project_id"/>
                <field name="category"/>
                <field name="quantity"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="needed_by"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-1">
                            <strong class="o_kanban_record_title text-primary">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="text-muted mb-2">
                            <i class="fa fa-folder me-1" title="Project"/> <field name="project_id"/>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-info text-white me-2">
                                <field name="category"/>
                            </span>
                            <span class="text-muted small">
                                Qty: <strong><field name="quantity"/></strong>
                            </span>
                        </div>
                        <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                            <div class="oe_kanban_bottom_left">
                                <field name="priority" widget="badge" decoration-danger="priority == 'high'" decoration-warning="priority == 'medium'" decoration-info="priority == 'low'"/>
                            </div>
                            <div class="oe_kanban_bottom_right text-muted small" t-if="record.needed_by.raw_value">
                                <i class="fa fa-clock-o me-1" title="Needed By"/> Needed: <field name="needed_by"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Research Requirement Pivot View -->
    <record id="view_research_requirement_pivot" model="ir.ui.view">
        <field name="name">research.requirement.pivot</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <pivot string="Requirements Analysis">
                <field name="project_id" type="row"/>
                <field name="category" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Research Requirement Graph View -->
    <record id="view_research_requirement_graph" model="ir.ui.view">
        <field name="name">research.requirement.graph</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <graph string="Requirements Quantity by Category" type="bar">
                <field name="category" type="row"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Research Requirement Search View -->
    <record id="view_research_requirement_search" model="ir.ui.view">
        <field name="name">research.requirement.search</field>
        <field name="model">research.requirement</field>
        <field name="arch" type="xml">
            <search string="Search Requirements">
                <field name="name"/>
                <field name="project_id"/>
                <field name="category"/>
                <field name="product_id"/>

                <filter name="requested" string="Requested" domain="[('status', '=', 'requested')]"/>
                <filter name="approved" string="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="fulfilled" string="Fulfilled" domain="[('status', '=', 'fulfilled')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter name="high_priority" string="High Priority" domain="[('priority', '=', 'high')]"/>
                <filter name="medium_priority" string="Medium Priority" domain="[('priority', '=', 'medium')]"/>
                <filter name="low_priority" string="Low Priority" domain="[('priority', '=', 'low')]"/>

                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Research Requirement Action -->
    <record id="action_research_requirement" model="ir.actions.act_window">
        <field name="name">Research Requirements</field>
        <field name="res_model">research.requirement</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_research_requirement_search"/>
    </record>

</odoo>