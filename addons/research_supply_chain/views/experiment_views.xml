<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Experiment Form View -->
    <record id="view_experiment_form" model="ir.ui.view">
        <field name="name">research.experiment.form</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <form string="Research Experiment">
                <header>
                    <button name="action_start" type="object" string="Start Experiment" class="oe_highlight" invisible="status != 'planned'"/>
                    <button name="action_complete" type="object" string="Complete Experiment" class="oe_highlight" invisible="status != 'running'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status in ('completed', 'cancelled')" groups="research_supply_chain.group_research_lead,research_supply_chain.group_research_manager,research_supply_chain.group_research_admin"/>
                    <field name="status" widget="statusbar" statusbar_visible="planned,running,completed,cancelled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Completed" bg_color="bg-success" invisible="status != 'completed'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="status != 'cancelled'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Experiment #101: Superconducting Qubit Coherence Test" readonly="status in ('completed', 'cancelled')"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="project_id" options="{'no_create': True}" readonly="status in ('completed', 'cancelled')"/>
                            <field name="create_uid" string="Created By" readonly="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="start_date" readonly="status in ('completed', 'cancelled')"/>
                            <field name="end_date" readonly="status in ('completed', 'cancelled')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Objective &amp; Methodology">
                            <group>
                                <field name="objective" placeholder="Primary hypothesis and scientific goals..." readonly="status in ('completed', 'cancelled')"/>
                                <field name="methodology" placeholder="Detailed experimental procedures, control parameters, and test protocols..." readonly="status in ('completed', 'cancelled')"/>
                            </group>
                        </page>
                        <page string="Used Resources">
                            <field name="experiment_resource_ids" readonly="status in ('completed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="resource_id"/>
                                    <field name="purpose"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Produced Outputs">
                            <field name="output_ids" readonly="status in ('completed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="output_type"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- Standard Odoo Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Experiment List View -->
    <record id="view_experiment_list" model="ir.ui.view">
        <field name="name">research.experiment.list</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <list string="Experiments">
                <field name="name"/>
                <field name="project_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="create_uid" string="Created By"/>
                <field name="status" widget="badge" decoration-info="status == 'planned'" decoration-warning="status == 'running'" decoration-success="status == 'completed'" decoration-danger="status == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Experiment Kanban View -->
    <record id="view_experiment_kanban" model="ir.ui.view">
        <field name="name">research.experiment.kanban</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="create_uid"/>
                <field name="resource_count"/>
                <field name="output_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-1">
                            <strong class="o_kanban_record_title text-primary">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="text-muted mb-2">
                            <i class="fa fa-folder me-1" title="Project"/> <field name="project_id"/>
                        </div>
                        <div class="text-muted small mb-2" t-if="record.start_date.raw_value">
                            <i class="fa fa-calendar me-1" title="Schedule"/> <field name="start_date"/> - <field name="end_date"/>
                        </div>
                        <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                            <div class="oe_kanban_bottom_left">
                                <span class="badge rounded-pill bg-light text-dark border me-1" title="Resources Used">
                                    <i class="fa fa-cubes text-warning me-1"/> <t t-esc="record.resource_count.raw_value"/>
                                </span>
                                <span class="badge rounded-pill bg-light text-dark border" title="Outputs Produced">
                                    <i class="fa fa-file-text-o text-success me-1"/> <t t-esc="record.output_count.raw_value"/>
                                </span>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="create_uid" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Experiment Pivot View -->
    <record id="view_experiment_pivot" model="ir.ui.view">
        <field name="name">research.experiment.pivot</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <pivot string="Experiments Analysis">
                <field name="project_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Experiment Graph View -->
    <record id="view_experiment_graph" model="ir.ui.view">
        <field name="name">research.experiment.graph</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <graph string="Experiments Status Breakdown" type="bar">
                <field name="status" type="row"/>
            </graph>
        </field>
    </record>

    <!-- Experiment Search View -->
    <record id="view_experiment_search" model="ir.ui.view">
        <field name="name">research.experiment.search</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <search string="Search Experiments">
                <field name="name"/>
                <field name="project_id"/>
                <field name="objective"/>
                <field name="create_uid"/>

                <filter name="planned" string="Planned" domain="[('status', '=', 'planned')]"/>
                <filter name="running" string="Running" domain="[('status', '=', 'running')]"/>
                <filter name="completed" string="Completed" domain="[('status', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter name="my_experiments" string="My Experiments" domain="[('create_uid', '=', uid)]"/>

                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_creator" string="Created By" context="{'group_by': 'create_uid'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Experiment Action -->
    <record id="action_experiment" model="ir.actions.act_window">
        <field name="name">Experiments</field>
        <field name="res_model">research.experiment</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_experiment_search"/>
    </record>

</odoo>