<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Experiment List View -->
    <record id="view_experiment_list" model="ir.ui.view">
        <field name="name">research.experiment.list</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <!-- Experiment Form View -->
    <record id="view_experiment_form" model="ir.ui.view">
        <field name="name">research.experiment.form</field>
        <field name="model">research.experiment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="planned,running,completed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="created_by"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Objective">
                            <field name="objective"/>
                        </page>
                        <page string="Methodology">
                            <field name="methodology"/>
                        </page>
                        <page string="Used Resources">
                            <field name="experiment_resource_ids">
                                <list editable="bottom">
                                    <field name="resource_id"/>
                                    <field name="purpose"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outputs">
                            <field name="output_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="output_type"/>
                                    <field name="status"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Experiment Action -->
    <record id="action_experiment" model="ir.actions.act_window">
        <field name="name">Experiments</field>
        <field name="res_model">research.experiment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
